# CloudVault Concierge — Local Operator PC Workbench Environment Configuration
# Copy this file to `workbench/.env` and populate your Supabase project credentials.
# NEVER commit `workbench/.env` or `workbench/.keys/operator_private.pem` to Git!

# Local Workbench Binding (MUST remain 127.0.0.1 — NEVER 0.0.0.0)
WORKBENCH_HOST=127.0.0.1
WORKBENCH_PORT=8790

# Local High-Speed Staging Root (MUST NEVER be inside OneDrive / cloud-synced folders)
STAGING_ROOT=D:\MigrationJobs

# Operator Node Display Label registered in Supabase `operator_nodes`
OPERATOR_NODE_LABEL=Operator-PC-Primary

# Public Customer Portal URL (Vercel deployment or http://localhost:3000 for local dev)
PUBLIC_WEB_URL=https://cloudvault-concierge.vercel.app

# Supabase Relay Credentials (Service Role Key stays strictly on this local operator PC)
# Leave blank to run in Offline Local JSON Mode (`workbench/.local_state/jobs.json`)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Zero-Knowledge Encrypted Search Vault Storage (Cloudflare R2 Free 10 GB, $0 Egress)
# Leave blank to fall back to Local Encrypted PC NAS (`SEARCH_VAULT_BLOBS_ROOT`)
SEARCH_VAULT_BLOBS_ROOT=D:\SearchVaultBlobs
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=cloudvault-search-blobs
