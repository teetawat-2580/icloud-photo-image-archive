# Supabase Project Configuration (Required for /api/jobs/* endpoints)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Only Secret Key — NEVER expose to client or prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Public Concierge Contact Channel (LINE Official Account or Inquiry Link)
NEXT_PUBLIC_LINE_CONTACT_URL=https://line.me/R/ti/p/@cloudvault-concierge

# Zero-Knowledge Encrypted Search Vault Blob Backend (Server-Only — NEVER prefix with NEXT_PUBLIC_)
# Option A: Cloudflare R2 Free 10 GB ($0 Egress)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=cloudvault-search-blobs
# Option B: Local PC acting as Encrypted NAS via Cloudflare Tunnel
PC_TUNNEL_NAS_BASE_URL=https://your-pc-nas-tunnel.example.com
